{
  "name": "ai-life-sim",
  "version": "5.1.7",
  "private": true,
  "scripts": {
    "dev": "node scripts/codegen/generate-mod-wiring.mjs && next dev --turbopack",
    "dev:warm": "node scripts/codegen/generate-mod-wiring.mjs && node scripts/dev/dev-with-warmup.mjs",
    "dev:warmup": "node scripts/dev/warm-dev-server.mjs",
    "build": "node scripts/codegen/generate-mod-wiring.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "generate:wiring": "node scripts/codegen/generate-mod-wiring.mjs",
    "mod:create": "node scripts/codegen/create-mod.mjs",
    "release:record": "node scripts/release/record-game-update.mjs",
    "logs:inspect": "node scripts/ops/inspect-ai-logs.mjs",
    "check:changelog": "node scripts/check/domains/ui/game-changelog-regression.mjs",
    "validate:narrative": "node scripts/check/domains/narrative/validate-narrative-wiring.mjs && node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/semantic-authority-audit.mjs && node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/narrative-chinese-protocol-regression.mjs",
    "validate:regression": "node scripts/check/domains/narrative/narrative-regression-seed.mjs",
    "test:creation-first-narrative": "node scripts/check/domains/narrative/character-first-narrative-slice.mjs",
    "test:creation-first-narrative:browser": "node scripts/check/domains/ui/character-first-narrative-browser.cjs",
    "test:new-life-isolation": "node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/ui/new-life-isolation-smoke.mjs",
    "test:compression-runtime": "node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/compression-runtime-smoke.mjs",
    "test:narrative-protocol": "node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/narrative-chinese-protocol-regression.mjs",
    "test:narrative-opening:live": "node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/narrative-opening-live-eval.mjs",
    "test:ai-proxy": "node scripts/check/domains/narrative/ai-proxy-observability-regression.mjs && node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/server-log-store-smoke.mjs && node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/diagnostic-player-code-smoke.mjs && node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/ai-error-translation-smoke.mjs && node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/cache-stats-smoke.mjs",
    "test:player-feedback": "node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/player-feedback-smoke.mjs",
    "test:destiny-credential-terminal": "node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/destiny-credential-terminal-smoke.mjs",
    "test:world-context-p0": "node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/mod/world-context-p0-smoke.mjs",
    "test:historical-event-prompt": "node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/historical-event-prompt-projection-smoke.mjs",
    "test:historical-event-p1": "node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/mod/historical-event-p1-smoke.mjs && npm run test:historical-event-prompt",
    "test:history-causality-p1": "npm run test:historical-event-p1",
    "test:release-cleanup": "node scripts/check/domains/narrative/release-cleanup-smoke.mjs",
    "test:managed-ai-default": "node scripts/check/domains/narrative/managed-ai-default-regression.mjs && node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/managed-sse-aggregation-smoke.mjs",
    "test:loader": "node scripts/check/domains/structural/test-mod-loader.mjs",
    "test:calibration": "node scripts/check/domains/calibration/world-calibration-acceptance.mjs",
    "test:prompt-wiring": "node --no-warnings=ExperimentalWarning --loader ./scripts/check/lib/typescript-loader.mjs scripts/check/domains/narrative/kv-prompt-audit.mjs && node scripts/check/domains/narrative/time-bridge-smoke.mjs && node scripts/check/domains/narrative/adaptation-calibration-audit.mjs",
    "generate:deps": "node scripts/check/dev/generate-dependency-graph.mjs",
    "check": "node scripts/check/index.mjs full",
    "check:quick": "node scripts/check/index.mjs quick",
    "check:changed": "node scripts/check/index.mjs changed",
    "check:structural": "node scripts/check/index.mjs structural",
    "check:refactor": "node scripts/check/index.mjs refactor",
    "check:wiring": "node scripts/check/index.mjs wiring",
    "check:mod": "node scripts/check/index.mjs mod",
    "check:ui": "node scripts/check/index.mjs ui",
    "check:verbose": "node scripts/check/index.mjs full --verbose",
    "gate-check": "node scripts/check/gate-check.mjs",
    "gate-check:quick": "node scripts/check/gate-check.mjs --quick"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
