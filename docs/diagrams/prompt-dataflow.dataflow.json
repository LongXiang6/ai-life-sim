      { "id": "result-branch", "label": "结果分流", "focus": ["request", "story", "specialists", "commit"], "note": "查看主故事结果与两个专项结果如何汇合。" },
      { "id": "state-sinks", "label": "状态落点", "focus": ["commit", "character", "history", "ui"], "note": "查看属性、正文与连续性结果的最终去向。" }
