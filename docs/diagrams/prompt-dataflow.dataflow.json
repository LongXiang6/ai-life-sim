    { "dot": "amber", "title": "结果契约", "items": ["主故事输出正文、属性变化与分支结局文本", "属性变化仅记录重大事件的 ±1", "02/03 结果不改写主故事正文"] },
    { "dot": "emerald", "title": "状态落点", "items": ["Character Base 独占属性写入", "Narrative Stores 保存正文与连续性", "历史账本仅由所属本地系统维护，不进入 AI 数据层"] }
  ]
