# 复制本文件为 .env.local 后填写真实值
# 命令：copy .env.example .env.local  （Windows）
#
# 说明：
# - 这些 Key 仅用于服务端 /api/proxy 代理，不会写入 Git
# - 也可在应用「设置」页填写自定义 API Key，不必全部配置
# - 留空表示该厂商走客户端设置或不可用

# 默认 LongCat 免费体验通道
LONGCAT_API_KEY=
LONGCAT_BASE_URL=
# 保留的原 a6api 免费体验通道
MANAGED_AI_API_KEY=
MANAGED_A6_BASE_URL=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
ALIBUN_API_KEY=
BYTEDANCE_API_KEY=
TENCENT_API_KEY=
BAIDU_API_KEY=

# 客户端 AI 调试日志开关；生产环境可关闭公开调试页，AI 代理仍保留服务端诊断链
NEXT_PUBLIC_DISABLE_DEBUG_LOGS=false
# 仅在确实不需要采集完整 AI 调试元数据时设为 true；生产默认继续采集，公开查看仍关闭。
NEXT_PUBLIC_DISABLE_DEBUG_LOG_COLLECTION=false

# 服务端明文 SQLite 诊断日志（默认启用），自动只保留昨天和今天。
AI_DIAGNOSTIC_LOGS_ENABLED=true
# 可直接指定数据库文件；生产默认 /var/lib/ai-life-sim/logs.sqlite，本地默认 .data/logs.sqlite。
AI_LOG_DB_PATH=
# 兼容既有部署：未设置 AI_LOG_DB_PATH 时会在此目录创建 logs.sqlite。
AI_LOG_DIR=

# 可选玩家账号与云同步。生产使用发布目录外的绝对路径，并为目录设置 0700、文件设置 0600。
ACCOUNT_DB_PATH=
# 每个已登录账号一个覆盖式云端手动存档，以及默认关闭的排行榜/画像邮箱后台。
PLAYER_CONTENT_DB_PATH=
PLAYER_LEADERBOARD_ENABLED=1
PLAYER_MAILBOX_ENABLED=1
PORTRAIT_IMAGE_ENABLED=0
PORTRAIT_IMAGE_BASE_URL=https://dasuapi.com
PORTRAIT_IMAGE_MODEL=gpt-image-2
# 只写服务器环境文件，禁止提交真实绘图 Key。
PORTRAIT_IMAGE_API_KEY=
PORTRAIT_ASSET_ROOT=
# 32 字节随机密钥，支持 64 位十六进制或 Base64；只存在服务器环境，禁止提交或轮换时丢失旧密钥。
ACCOUNT_DATA_ENCRYPTION_KEY=
# 逗号或换行分隔的额外用户名违禁片段；也可指向一份服务器私有 UTF-8 文件。
ACCOUNT_USERNAME_BLOCKLIST=
ACCOUNT_USERNAME_BLOCKLIST_PATH=
# QQ Bot 仅通过回环地址调用主服务；两边配置同一个独立的 32+ 字符随机密钥。
# 该密钥只用于 HMAC 请求签名，不得与账号加密密钥、OneBot Token 或管理员 Token 复用。
QQ_BOT_INTEGRATION_SECRET=
