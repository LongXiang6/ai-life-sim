# 复制本文件为 .env.local 后填写真实值
# 命令：copy .env.example .env.local  （Windows）
#
# 说明：
# - 这些 Key 仅用于服务端 /api/proxy 代理，不会写入 Git
# - 也可在应用「设置」页填写自定义 API Key，不必全部配置
# - 留空表示该厂商走客户端设置或不可用

MANAGED_AI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
ALIBUN_API_KEY=
BYTEDANCE_API_KEY=
TENCENT_API_KEY=
BAIDU_API_KEY=

# 客户端 AI 调试日志开关；生产环境可关闭公开调试页，AI 代理仍保留服务端诊断链
NEXT_PUBLIC_DISABLE_DEBUG_LOGS=false
# 仅在确实不需要采集完整 AI 调试元数据时设为 true；生产默认继续采集，公开查看仍关闭。
NEXT_PUBLIC_DISABLE_DEBUG_LOG_COLLECTION=false

# 服务端诊断日志（默认启用）。生产环境建议把目录放在发布目录之外，跨版本保留。
AI_DIAGNOSTIC_LOGS_ENABLED=true
AI_LOG_DIR=
AI_LOG_RETENTION_DAYS=30
AI_LOG_MAX_TOTAL_BYTES=10737418240
AI_LOG_MAX_FILE_BYTES=67108864
